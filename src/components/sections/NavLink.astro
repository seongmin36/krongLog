---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
const { pathname } = Astro.url;

const isActive = pathname === href || pathname.startsWith(`${href}/`);
---

<a
  href={href}
  class:list={[
    "relative py-1 text-sm font-medium text-gray-500 no-underline transition-colors duration-200 dark:text-gray-400",
    "hover:text-gray-900 dark:hover:text-gray-50",
    isActive &&
      "after:bg-primary font-semibold! text-gray-900! after:absolute after:right-0 after:bottom-[-2px] after:left-0 after:h-0.5 after:rounded-sm after:content-[''] dark:text-gray-50!",
    className,
  ]}
  aria-current={isActive ? "page" : undefined}
  data-astro-prefetch
  {...props}
>
  <slot />
</a>
