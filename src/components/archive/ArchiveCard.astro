---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { archivePostPath } from "@/lib/blog-url";
import { formatKstMonthDay, formatKstTime } from "@/lib/format-date";
import {
  archiveExcerpt,
  archiveTilt,
  archiveVariant,
  type ArchiveEntry,
} from "@/lib/archive";

interface Props {
  entry: ArchiveEntry;
}

const { entry } = Astro.props;
const { title, date, icon, tags, image, quote, author } = entry.data;

const variant = archiveVariant(entry);
const excerpt = archiveExcerpt(entry);
const isHeadline = variant === "headline";
const isQuote = variant === "quote";

const shellClass = isHeadline
  ? "border-transparent bg-dark px-7 py-8 dark:border-border-dark dark:bg-black/40"
  : isQuote
    ? "border-primary/20 bg-primary/5 px-7 py-8 dark:border-dark-text/25 dark:bg-primary-surface-dark"
    : "border-border bg-white p-6 dark:border-border-dark dark:bg-white/4";
const metaClass = isHeadline
  ? "text-white/50"
  : "text-muted-alpha dark:text-muted-dark";
const tagClass = isHeadline
  ? "text-white/60"
  : "text-description/70 dark:text-muted";
const titleClass = isHeadline
  ? "mt-5 text-2xl leading-[1.45] tracking-[-0.02em] text-white"
  : "text-dark group-hover:text-primary dark:group-hover:text-dark-text mt-4 text-[18px] leading-[1.45] tracking-[-0.015em] dark:text-gray-50";
---

<article
  class="min-w-0"
  data-archive-card
  style={`--tilt: ${archiveTilt(entry.id)}`}
>
  <a
    href={archivePostPath(entry.id)}
    class:list={[
      "group hover:border-primary hover:shadow-primary/40 dark:hover:border-dark-text dark:hover:shadow-dark-text/30 block rotate-(--tilt) rounded-2xl border transition-[rotate,translate,border-color,box-shadow] duration-300 hover:-translate-y-1 hover:rotate-0 hover:shadow-[0_6px_28px_-2px] motion-reduce:transition-none",
      shellClass,
    ]}
    data-astro-prefetch
  >
    <!-- 아이콘 · 날짜 -->
    <div class:list={["flex items-center gap-2 text-xs", metaClass]}>
      <Icon name={icon} class="size-3.75 shrink-0" aria-hidden="true" />
      <time datetime={date.toISOString()}>
        {formatKstMonthDay(date)} · {formatKstTime(date)}
      </time>
    </div>

    {
      isQuote ? (
        <>
          <h3 class="sr-only">{title}</h3>
          <Icon
            name="lucide:quote"
            class="text-primary dark:text-dark-text mt-5 size-6"
            aria-hidden="true"
          />
          <p class="text-dark mt-3 font-serif text-xl leading-normal tracking-[-0.01em] italic dark:text-gray-50">
            {quote}
          </p>
          {author && (
            <p class="text-primary dark:text-dark-text mt-4 text-[13px] font-bold">
              — {author}
            </p>
          )}
        </>
      ) : (
        <>
          {image && (
            <div class="-mx-2 mt-4 aspect-4/3 overflow-hidden rounded-[14px] bg-gray-100 dark:bg-gray-800">
              <Image
                src={image}
                alt=""
                format="webp"
                quality={75}
                widths={[400, 560, 720, 840]}
                sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 400px"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
          )}

          <h3
            class:list={[
              "font-bold transition-colors duration-200",
              titleClass,
            ]}
          >
            {title}
          </h3>

          {excerpt && (
            <p
              class:list={[
                "text-description dark:text-dark-description mt-2 text-[14.5px] leading-[1.75]",
                variant === "image" ? "line-clamp-2" : "line-clamp-4",
              ]}
            >
              {excerpt}
            </p>
          )}
        </>
      )
    }

    {
      tags && tags.length > 0 && (
        <p class:list={["mt-5 flex flex-wrap gap-x-1.5 text-xs", tagClass]}>
          {tags.map((tag) => (
            <span>#{tag}</span>
          ))}
        </p>
      )
    }
  </a>
</article>
