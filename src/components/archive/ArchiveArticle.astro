---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { archiveIndexPath, archivePostPath } from "@/lib/blog-url";
import { formatKstDotDate, formatKstTime } from "@/lib/format-date";
import {
  archiveHasBody,
  archiveVariant,
  type ArchiveEntry,
} from "@/lib/archive";

interface Props {
  entry: ArchiveEntry;
  /** 더 오래된 글 */
  older?: ArchiveEntry;
  /** 더 최근 글 */
  newer?: ArchiveEntry;
}

const { entry, older, newer } = Astro.props;
const { title, date, icon, tags, image, quote, author } = entry.data;

const variant = archiveVariant(entry);
const isHeadline = variant === "headline";
const isQuote = variant === "quote";

const neighborClass =
  "hover:bg-hover-overlay-light dark:hover:bg-hover-overlay-dark flex min-w-0 flex-col rounded-[14px] p-4 transition-colors duration-150";
const neighborLabelClass =
  "text-muted-alpha dark:text-muted-dark flex items-center gap-1 text-xs";
const neighborTitleClass =
  "text-dark mt-2 flex items-start gap-1.5 text-[15px] leading-normal font-bold dark:text-gray-50";
---

<div class="pt-10 pb-24 sm:pt-14 sm:pb-32">
  <a
    href={archiveIndexPath()}
    class="text-muted-alpha hover:text-primary dark:text-muted-dark dark:hover:text-dark-text inline-flex items-center gap-1.5 text-[13.5px] transition-colors duration-200"
    data-astro-prefetch
  >
    <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
    아카이브 목록
  </a>

  <article class="mx-auto mt-14 max-w-160 sm:mt-20">
    <header>
      <!-- 아이콘 · 날짜 · 시간 -->
      <div
        class="text-muted-alpha dark:text-muted-dark flex items-center gap-3 text-[13px]"
      >
        <Icon name={icon} class="size-5.5 shrink-0" aria-hidden="true" />
        <time datetime={date.toISOString()} class="flex items-center gap-3">
          <span>{formatKstDotDate(date)}</span>
          <span class="bg-muted-alpha size-1 rounded-full" aria-hidden="true"
          ></span>
          <span>{formatKstTime(date)}</span>
        </time>
      </div>

      <h1
        class:list={[
          "text-dark mt-6 font-bold break-keep dark:text-gray-50",
          isHeadline
            ? "text-[44px] leading-[1.3] tracking-[-0.035em]"
            : "text-[34px] leading-[1.35] tracking-[-0.03em]",
        ]}
      >
        {title}
      </h1>
    </header>

    {
      isQuote && (
        <figure class="border-primary dark:border-dark-text mt-10 border-l-2 pl-8">
          <Icon
            name="lucide:quote"
            class="text-primary dark:text-dark-text size-8"
            aria-hidden="true"
          />
          <blockquote class="text-dark font-quote mt-4 text-[34px] leading-[1.4] tracking-[-0.02em] italic dark:text-gray-50">
            {quote}
          </blockquote>
          {author && (
            <figcaption class="text-primary dark:text-dark-text mt-6 text-[15px] font-semibold">
              — {author}
            </figcaption>
          )}
        </figure>
      )
    }

    {
      image && (
        <div class="mt-8 rotate-[-0.6deg] overflow-hidden rounded-2xl bg-gray-100 dark:bg-gray-800">
          <Image
            src={image}
            alt={title}
            format="webp"
            quality={85}
            widths={[640, 960, 1280]}
            sizes="(max-width: 703px) 100vw, 640px"
            class="aspect-4/3 h-auto w-full object-cover"
            priority
          />
        </div>
      )
    }

    {
      archiveHasBody(entry) && (
        <div class="prose prose-blog mt-8 text-[17px]">
          <slot />
        </div>
      )
    }

    {
      tags && tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="border-primary/20 bg-primary/5 text-primary dark:border-dark-text/25 dark:bg-primary-surface-dark dark:text-dark-text rounded-full border px-3 py-1 text-[12.5px]">
              #{tag}
            </li>
          ))}
        </ul>
      )
    }

    <!-- 이전 · 다음 -->
    <nav
      aria-label="이전·다음 아카이브"
      class="border-border dark:border-border-dark mt-20 border-t pt-4"
    >
      <div class="-mx-4 grid grid-cols-2 gap-2">
        {
          older ? (
            <a
              href={archivePostPath(older.id)}
              class={neighborClass}
              data-astro-prefetch
            >
              <span class={neighborLabelClass}>
                <Icon
                  name="lucide:arrow-left"
                  class="size-3.5"
                  aria-hidden="true"
                />
                이전 아카이브
              </span>
              <span class={neighborTitleClass}>
                <Icon
                  name={older.data.icon}
                  class="mt-0.75 size-4 shrink-0"
                  aria-hidden="true"
                />
                <span class="line-clamp-2 break-keep">{older.data.title}</span>
              </span>
            </a>
          ) : (
            <div />
          )
        }
        {
          newer ? (
            <a
              href={archivePostPath(newer.id)}
              class:list={[neighborClass, "items-end text-right"]}
              data-astro-prefetch
            >
              <span class:list={[neighborLabelClass, "justify-end"]}>
                다음 아카이브
                <Icon
                  name="lucide:arrow-right"
                  class="size-3.5"
                  aria-hidden="true"
                />
              </span>
              <span class:list={[neighborTitleClass, "justify-end"]}>
                <Icon
                  name={newer.data.icon}
                  class="mt-0.75 size-4 shrink-0"
                  aria-hidden="true"
                />
                <span class="line-clamp-2 break-keep">{newer.data.title}</span>
              </span>
            </a>
          ) : (
            <div />
          )
        }
      </div>
    </nav>
  </article>
</div>
