---
import AboutDivider from "@/components/about/AboutDivider.astro";

interface Props {
  number: string;
  title: string;
  id: string;
  description?: string;
  /** split: 제목 왼쪽 · 본문 오른쪽(lg 이상) / stack: 제목 아래 본문 */
  layout?: "split" | "stack";
  compact?: boolean;
}

const {
  number,
  title,
  id,
  description,
  layout = "stack",
  compact = false,
} = Astro.props;

const isSplit = layout === "split";
const sectionClass = compact ? "py-16 lg:py-24" : "py-16 lg:py-30";
const gridClass = isSplit
  ? "lg:grid lg:grid-cols-[340px_1fr] lg:items-start lg:gap-12"
  : "";
const bodyClass = isSplit ? "mt-10 min-w-0 lg:mt-0" : "mt-12 min-w-0";
// split에서만 제목을 스크롤 중 고정한다 (grid 직접 자식)
const headerClass = isSplit
  ? "flex items-end justify-between gap-4 lg:sticky lg:top-36"
  : "flex items-end justify-between gap-4";
const hasActions = Astro.slots.has("actions");
---

<AboutDivider />

<section aria-labelledby={id} class={sectionClass}>
  <div class={gridClass}>
    <div class={headerClass}>
      <div>
        <p
          class="text-primary dark:text-dark-text font-mono text-sm leading-none"
        >
          {number}
        </p>
        <h2
          id={id}
          class="text-dark mt-2.5 text-[28px] leading-[1.28] font-bold tracking-[-0.02em] sm:text-[32px] dark:text-gray-50"
        >
          {title}
        </h2>
        {
          description && (
            <p class="text-description dark:text-muted mt-2.5 text-[17px] leading-[1.75] break-keep">
              {description}
            </p>
          )
        }
      </div>
      {
        hasActions && (
          <div class="shrink-0">
            <slot name="actions" />
          </div>
        )
      }
    </div>
    <div class={bodyClass}>
      <slot />
    </div>
  </div>
</section>
