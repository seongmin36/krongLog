---
import { Icon } from "astro-icon/components";
---

<section class="py-20 lg:py-30">
  <p
    class="flex flex-wrap justify-center gap-x-3 gap-y-1 text-center text-[18px] leading-[1.45] tracking-[-0.02em] sm:text-[22px]"
  >
    <span class="text-description dark:text-muted">
      어떤 걸 만들어 왔는지 궁금하다면
    </span>
    <a
      role="link"
      aria-disabled="true"
      class="text-primary dark:text-dark-text inline-flex items-center gap-1.5 font-bold"
    >
      포트폴리오 보러 가기
      <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
    </a>
  </p>
</section>
