---
import { Icon } from "astro-icon/components";
import AboutSection from "@/components/about/AboutSection.astro";
import { archiveIndexPath, blogsIndexPath } from "@/lib/blog-url";
import "@/styles/chip.css";

interface Props {
  postCount: number;
  archiveCount: number;
  topTags: [string, number][];
}

const { postCount, archiveCount, topTags } = Astro.props;

const recordCardClass =
  "border-border bg-white hover:bg-primary-surface hover:border-primary/30 dark:border-border-dark dark:bg-dark dark:hover:bg-primary-surface-dark dark:hover:border-dark-text/30 flex flex-col rounded-3xl border p-8 no-underline transition-colors duration-200";
---

<AboutSection
  number="05"
  title="기록"
  id="about-records"
  layout="split"
  compact
>
  <div>
    <div class="grid max-w-[640px] gap-6 sm:grid-cols-2">
      <a href={blogsIndexPath()} class={recordCardClass} data-astro-prefetch>
        <span
          class="text-dark block font-mono text-[40px] leading-none font-bold tracking-[-0.03em] dark:text-gray-50"
        >
          {postCount}
        </span>
        <span
          class="text-description dark:text-muted mt-5 flex items-center justify-between text-[17px]"
        >
          개의 블로그 글
          <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
        </span>
      </a>
      <a href={archiveIndexPath()} class={recordCardClass} data-astro-prefetch>
        <span
          class="text-dark block font-mono text-[40px] leading-none font-bold tracking-[-0.03em] dark:text-gray-50"
        >
          {archiveCount}
        </span>
        <span
          class="text-description dark:text-muted mt-5 flex items-center justify-between text-[17px]"
        >
          개의 끄적임
          <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
        </span>
      </a>
    </div>

    <div class="mt-10">
      <p class="flex flex-wrap items-baseline gap-2">
        <span class="text-description dark:text-muted text-[17px]">
          블로그에서 자주 다룬 주제
        </span>
        <span class="text-muted-alpha dark:text-muted-dark text-[13px]">
          실제 글 데이터 기준 상위 5개
        </span>
      </p>
      <div class="mt-3.5 flex flex-wrap gap-2">
        {
          topTags.map(([tag]) => (
            <span class="chip pointer-events-none">{tag}</span>
          ))
        }
      </div>
    </div>
  </div>
</AboutSection>
