---
import Tag from "@/components/ui/Tag.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import placeholderImage from "@/assets/img-default.png";

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description?: string;
      date: Date;
      tags?: string[];
      image?: ImageMetadata;
    };
  };
}

const { post } = Astro.props;
const { title, description, date, tags, image } = post.data;

const formattedDate = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---

<a
  href={`/blogs/${post.id}`}
  class="group dark:bg-dark flex flex-col overflow-hidden bg-white transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-black/5"
  data-astro-prefetch
>
  <div
    class="relative aspect-16/10 overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800"
  >
    {
      image ? (
        <Image
          src={image}
          alt={title}
          width={800}
          height={500}
          format="webp"
          quality="high"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <Image
          src={placeholderImage}
          alt="placeholder"
          width={800}
          height={500}
          format="webp"
          quality="high"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>

  <!-- 카드 본문 -->
  <div class="flex flex-1 flex-col gap-2.5 py-4 sm:py-5">
    <!-- 태그 목록 -->
    {
      tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <Tag name={tag} />
          ))}
        </div>
      )
    }

    <!-- 제목 -->
    <h3
      class="group-hover:text-primary line-clamp-2 text-[15px] leading-snug font-bold text-gray-900 transition-colors duration-200 sm:text-base dark:text-gray-50"
    >
      {title}
    </h3>

    <!-- 설명 -->
    {
      description && (
        <p class="text-description dark:text-dark-description line-clamp-2 text-[13px] leading-relaxed">
          {description}
        </p>
      )
    }

    <!-- 날짜 -->
    <time
      datetime={date.toISOString()}
      class="mt-auto pt-1 text-xs text-gray-400 dark:text-gray-500"
    >
      {formattedDate}
    </time>
  </div>
</a>
