---
import { getTagColor } from "@/lib/utils/tags";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description?: string;
      date: Date;
      tags?: string[];
      image?: ImageMetadata;
    };
  };
}

const { post } = Astro.props;
const { title, description, date, tags, image } = post.data;

const formattedDate = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---

<a
  href={`/blogs/${post.id}`}
  class="group flex flex-col overflow-hidden bg-white dark:bg-[#1a1a1a] transition-all duration-300 hover:shadow-lg hover:shadow-black/5 dark:hover:shadow-black/20 hover:-translate-y-1"
  data-astro-prefetch
>
  <div class="relative aspect-16/10 overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800">
    {image ? (
      <Image
        src={image}
        alt={title}
        width={800}
        height={500}
        format="webp"
        quality={80}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="w-full h-full bg-linear-to-br from-gray-100 to-gray-200 dark:from-gray-800 dark:to-gray-700" />
    )}
  </div>

  <!-- 카드 본문 -->
  <div class="flex flex-col flex-1 gap-2.5 py-4 sm:py-5">
    <!-- 태그 목록 -->
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => {
          const color = getTagColor(tag);
          return (
            <span
              class={`inline-block px-2 py-0.5 rounded-md text-[11px] font-medium leading-relaxed ${color.bg} ${color.text}`}
            >
              {tag}
            </span>
          );
        })}
      </div>
    )}

    <!-- 제목 -->
    <h3 class="text-[15px] sm:text-base font-bold leading-snug text-gray-900 dark:text-gray-50 line-clamp-2 group-hover:text-primary transition-colors duration-200">
      {title}
    </h3>

    <!-- 설명 -->
    {description && (
      <p class="text-[13px] leading-relaxed text-gray-500 dark:text-gray-400 line-clamp-2">
        {description}
      </p>
    )}

    <!-- 날짜 -->
    <time
      datetime={date.toISOString()}
      class="mt-auto pt-1 text-xs text-gray-400 dark:text-gray-500"
    >
      {formattedDate}
    </time>
  </div>
</a>
