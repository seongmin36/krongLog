---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Tag from "@/components/ui/Tag.astro";
import { blogPostPath } from "@/lib/blog-url";
import { formatDotDate } from "@/lib/format-date";
import placeholderImage from "@/assets/img-default.png";

interface Props {
  post: CollectionEntry<"post">;
  rank: number;
  priorityLcp?: boolean;
}

const { post, rank, priorityLcp = false } = Astro.props;
const { title, description, date, tags, image } = post.data;
---

<a
  href={blogPostPath(post.id)}
  class="group grid grid-cols-1 items-center gap-6 lg:grid-cols-[5fr_4fr] lg:gap-12"
  data-astro-prefetch
>
  <div
    class="relative aspect-16/10 overflow-hidden rounded-xl bg-gray-100 lg:rounded-2xl dark:bg-gray-800"
  >
    <Image
      src={image ?? placeholderImage}
      alt={image ? title : "placeholder"}
      format="webp"
      quality={75}
      widths={[400, 640, 800, 960, 1280]}
      sizes="(max-width: 1023px) 100vw, 680px"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      priority={priorityLcp}
    />
    <span
      class="text-primary dark:text-dark-text bg-latest-badge-surface absolute top-5 left-5 rounded-full px-3 py-1 font-mono text-[11.5px] font-bold tracking-[0.08em] backdrop-blur-sm dark:bg-black/60"
    >
      LATEST
    </span>
  </div>

  <div class="flex flex-col">
    <!-- 순번 · 날짜 -->
    <div class="flex items-center gap-3 font-mono text-[12.5px]">
      <span class="text-primary dark:text-dark-text" data-rank>
        {String(rank).padStart(2, "0")}
      </span>
      <span class="bg-border dark:bg-border-dark h-px w-8" aria-hidden="true"
      ></span>
      <time
        datetime={date.toISOString()}
        class="text-muted-alpha dark:text-muted-dark"
      >
        {formatDotDate(date)}
      </time>
    </div>

    <h2
      class="text-dark group-hover:text-primary dark:group-hover:text-dark-text mt-3 text-2xl leading-[1.4] font-bold tracking-[-0.03em] transition-colors duration-200 lg:mt-5 lg:text-[34px] lg:leading-[1.35] dark:text-gray-50"
    >
      {title}
    </h2>

    {
      description && (
        <p class="text-description dark:text-dark-description mt-3 line-clamp-2 text-[14.5px] leading-[1.75] lg:mt-4 lg:line-clamp-3 lg:text-[15.5px] lg:leading-[1.8]">
          {description}
        </p>
      )
    }

    <!-- 태그 · 화살표 -->
    <div class="mt-5 flex items-center justify-between gap-4 lg:mt-7">
      {
        tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <Tag name={tag} />
            ))}
          </div>
        )
      }
      <span
        class="border-border text-dark group-hover:border-primary group-hover:text-primary dark:border-border-dark dark:group-hover:border-dark-text dark:group-hover:text-dark-text ml-auto inline-flex size-11 shrink-0 items-center justify-center rounded-full border transition-colors duration-200 dark:text-gray-50"
        aria-hidden="true"
      >
        <Icon name="lucide:arrow-up-right" width={18} height={18} />
      </span>
    </div>
  </div>
</a>
