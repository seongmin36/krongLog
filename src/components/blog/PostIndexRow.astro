---
import type { CollectionEntry } from "astro:content";
import { blogPostPath } from "@/lib/blog-url";
import { formatDotDate } from "@/lib/format-date";

interface Props {
  post: CollectionEntry<"post">;
  rank: number;
}

const { post, rank } = Astro.props;
const { title, date, tags } = post.data;
---

<a
  href={blogPostPath(post.id)}
  class="group border-border hover:bg-hover-overlay-light dark:border-border-dark dark:hover:bg-hover-overlay-dark grid grid-cols-[36px_1fr] gap-x-3 gap-y-1.5 border-b px-2 py-5 transition-colors duration-150 md:grid-cols-[64px_1fr_auto_88px] md:items-center md:gap-x-8 md:py-6"
  data-astro-prefetch
>
  <span
    class="text-muted-alpha dark:text-muted-dark pt-1 font-mono text-[13px] md:pt-0"
    data-rank
  >
    {String(rank).padStart(2, "0")}
  </span>

  <span
    class="text-dark group-hover:text-primary dark:group-hover:text-dark-text text-[16.5px] leading-normal font-bold tracking-[-0.02em] transition-colors duration-200 md:min-w-0 md:truncate md:text-[19px] dark:text-gray-50"
  >
    {title}
  </span>

  {
    tags && tags.length > 0 ? (
      <span class="text-description/70 dark:text-muted col-start-2 font-mono text-xs md:col-start-auto md:text-[12.5px] md:whitespace-nowrap">
        {tags.map((tag) => `#${tag}`).join(" ")}
      </span>
    ) : (
      <span class="hidden md:block" aria-hidden="true" />
    )
  }

  <time
    datetime={date.toISOString()}
    class="text-muted-alpha dark:text-muted-dark col-start-2 font-mono text-xs md:col-start-auto md:text-right md:text-[12.5px]"
  >
    {formatDotDate(date)}
  </time>
</a>
