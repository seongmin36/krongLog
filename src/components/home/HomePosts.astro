---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import FeaturedPost from "@/components/blog/FeaturedPost.astro";
import PostCard from "@/components/blog/PostCard.astro";
import { blogsIndexPath } from "@/lib/blog-url";
import "@/styles/chip.css";
import Tag from "@/components/ui/Tag.astro";
import type { HomePostData } from "@/lib/blog";

interface Props {
  posts: CollectionEntry<"post">[];
  topTags: [string, number][];
  data: HomePostData[];
}

/** 대표글 1개 다음으로 카드 그리드에 보여줄 개수 (모바일은 4개, CSS로 제한) */
const GRID_SIZE = 6;

const { posts, topTags, data } = Astro.props;
const [first, ...rest] = posts;
// </script> 같은 문자열이 인라인 JSON을 끊지 않도록 < 이스케이프
const dataJson = JSON.stringify(data).replace(/</g, "\\u003c");
---

<div id="home-posts" data-grid-size={GRID_SIZE}>
  <!-- 태그 필터 칩 -->
  <div
    class="-mx-4 [scrollbar-width:none] overflow-x-auto px-4 pt-4 pb-8 sm:-mx-6 sm:px-6 lg:mx-0 lg:overflow-visible lg:px-0 lg:pt-0 lg:pb-10 [&::-webkit-scrollbar]:hidden"
  >
    <div
      class="flex w-max gap-2 lg:w-auto lg:flex-wrap"
      role="group"
      aria-label="태그 필터"
    >
      <button
        type="button"
        class="chip chip-active shrink-0"
        data-home-chip=""
        aria-pressed="true"
      >
        전체<span class="chip-count font-mono">{posts.length}</span>
      </button>
      {
        topTags.map(([tag, count]) => (
          <button
            type="button"
            class="chip shrink-0"
            data-home-chip={tag}
            aria-pressed="false"
          >
            {tag}
            <span class="chip-count font-mono">{count}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- 대표글 -->
  <section
    aria-label="최근 글"
    class="border-border dark:border-border-dark border-b pb-10 lg:pb-16"
    data-home-section="featured"
    hidden={!first}
  >
    {first && <FeaturedPost post={first} rank={1} priorityLcp />}
  </section>

  <!-- 카드 그리드 -->
  <section
    aria-label="최근 글 목록"
    class="grid grid-cols-1 gap-5 pt-10 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:pt-16 max-sm:[&>*:nth-child(n+5)]:hidden"
    data-home-section="card"
    hidden={rest.length === 0}
  >
    {
      rest.slice(0, GRID_SIZE).map((post) => (
        <div class="flex flex-col">
          <PostCard post={post} />
        </div>
      ))
    }
  </section>

  {
    first && (
      <>
        <template id="home-featured-tpl">
          <FeaturedPost post={first} rank={1} />
        </template>
        <template id="home-card-tpl">
          <div class="flex flex-col">
            <PostCard post={first} />
          </div>
        </template>
      </>
    )
  }

  <template id="home-tag-tpl"><Tag name="" /></template>
  <script type="application/json" id="home-posts-data" set:html={dataJson} />

  <!-- 전체 글 보기 -->
  <div class="mt-12 flex justify-center lg:mt-16">
    <a
      href={blogsIndexPath()}
      class="view-all group inline-flex items-center gap-3 rounded-full py-2 pr-1 pl-2"
      data-astro-prefetch
    >
      <span
        class="text-dark relative text-[15px] leading-[22.5px] font-bold dark:text-gray-50"
      >
        전체 글 보기
        <span
          class="view-all-line bg-primary dark:bg-dark-text absolute top-[25.5px] left-0 h-px w-full"
          aria-hidden="true"></span>
      </span>
      <span
        class="border-border text-dark group-hover:border-primary group-hover:text-primary dark:border-border-dark dark:group-hover:border-dark-text dark:group-hover:text-dark-text inline-flex size-9 items-center justify-center overflow-hidden rounded-full border transition-colors duration-200 dark:text-gray-50"
        aria-hidden="true"
      >
        <span class="view-all-arrow inline-flex">
          <Icon name="lucide:arrow-right" width={16} height={16} />
        </span>
      </span>
    </a>
  </div>
</div>

<style>
  /* 전체 글 보기: 밑줄은 호버 시 왼쪽부터 그려지고 벗어나면 오른쪽으로 사라짐, 화살표는 빠져나갔다 다시 들어옴 */
  .view-all-line {
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .view-all:hover .view-all-line,
  .view-all:focus-visible .view-all-line {
    transform: scaleX(1);
    transform-origin: left;
  }

  .view-all:hover .view-all-arrow,
  .view-all:focus-visible .view-all-arrow {
    animation: view-all-arrow 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  @keyframes view-all-arrow {
    0% {
      transform: translateX(0);
    }
    45% {
      transform: translateX(150%);
    }
    46% {
      transform: translateX(-150%);
    }
    100% {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .view-all-line {
      transition: none;
    }

    .view-all:hover .view-all-arrow,
    .view-all:focus-visible .view-all-arrow {
      animation: none;
    }
  }
</style>

<script>
  import type { HomePostData, HomePostImage } from "@/lib/blog";

  const root = document.getElementById("home-posts")!;
  const gridSize = Number(root.dataset.gridSize) || 6;
  const chips = root.querySelectorAll<HTMLButtonElement>("[data-home-chip]");
  const featuredSection = root.querySelector<HTMLElement>(
    '[data-home-section="featured"]',
  )!;
  const cardSection = root.querySelector<HTMLElement>(
    '[data-home-section="card"]',
  )!;
  const template = (id: string) =>
    document.getElementById(id) as HTMLTemplateElement | null;
  const featuredTpl = template("home-featured-tpl");
  const cardTpl = template("home-card-tpl");
  const tagTpl = template("home-tag-tpl")!;
  const data = JSON.parse(
    document.getElementById("home-posts-data")?.textContent ?? "[]",
  ) as HomePostData[];

  let activeTag = "";

  function createTag(name: string) {
    const el = tagTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    el.dataset.tag = name;
    el.textContent = name;

    return el;
  }

  // 템플릿을 복제해 data-field 자리에 글 데이터를 채움
  function fill(
    tpl: HTMLTemplateElement,
    post: HomePostData,
    image: HomePostImage,
  ) {
    const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const field = (name: string) =>
      node.querySelector<HTMLElement>(`[data-field="${name}"]`)!;

    const link =
      node instanceof HTMLAnchorElement ? node : node.querySelector("a")!;
    link.href = post.href;

    const img = node.querySelector("img")!;
    img.src = image.src;
    img.srcset = image.srcset;
    img.alt = post.alt;
    img.loading = "lazy";
    img.removeAttribute("fetchpriority");

    field("title").textContent = post.title;
    field("description").textContent = post.description;
    field("description").hidden = !post.description;

    const time = node.querySelector("time")!;
    time.dateTime = post.datetime;
    time.textContent = post.date;

    field("tags").replaceChildren(...post.tags.map(createTag));
    field("tags").hidden = post.tags.length === 0;
    return node;
  }

  function render() {
    if (!featuredTpl || !cardTpl) return;
    const matched = activeTag
      ? data.filter((post) => post.tags.includes(activeTag))
      : data;
    const [first, ...rest] = matched;

    featuredSection.replaceChildren(
      ...(first ? [fill(featuredTpl, first, first.featured)] : []),
    );
    cardSection.replaceChildren(
      ...rest.slice(0, gridSize).map((post) => fill(cardTpl, post, post.card)),
    );
    featuredSection.hidden = !first;
    cardSection.hidden = rest.length === 0;
  }

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      activeTag = chip.dataset.homeChip ?? "";
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle("chip-active", on);
        c.setAttribute("aria-pressed", String(on));
      });
      render();
    }),
  );
</script>
