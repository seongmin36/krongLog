---
interface Props {
  src: string;
  poster?: string;
}

const { src, poster } = Astro.props;
---

<div class="w-full overflow-hidden rounded-lg bg-transparent">
  <video class="block h-auto w-full" controls preload="metadata" poster={poster}>
    <source src={src} type="video/mp4" />
  </video>
</div>
