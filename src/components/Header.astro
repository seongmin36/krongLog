---
import NavLink from "@/components/sections/NavLink.astro";
import { blogsIndexPath } from "@/lib/blog-url";
import { AppIcon } from "@/components/ui/AppIcons";
import { ThemeToggle } from "@/components/ui/ThemeToggle";

const NAV_ITEMS = [
  // { href: "/about", label: "개발자 소개" },
  { href: blogsIndexPath(), label: "전체 글" },
] as const;
---

<header
  class="dark:bg-dark/85 sticky top-0 z-50 h-[60px] w-full border-b border-black/6 bg-white/85 backdrop-blur-md transition-colors duration-300 dark:border-white/6"
  id="main-header"
>
  <div
    class="mx-auto flex h-full max-w-[1280px] items-center justify-between px-4 sm:px-6"
  >
    <a
      href="/"
      class="group flex shrink-0 items-center no-underline"
      data-astro-prefetch
    >
      <span
        class="group-hover:text-primary dark:group-hover:text-primary text-lg font-bold tracking-tight text-gray-900 transition-colors duration-200 dark:text-gray-50"
      >
        Krong Dev.
      </span>
    </a>

    <nav class="flex items-center gap-4 sm:gap-8" aria-label="메인 네비게이션">
      <ul
        class="m-0 flex list-none items-center gap-3 p-0 sm:gap-6"
        role="list"
      >
        {
          NAV_ITEMS.map((item) => (
            <li>
              <NavLink href={item.href}>{item.label}</NavLink>
            </li>
          ))
        }
      </ul>

      <div
        class="flex items-center gap-0 sm:gap-1"
        role="toolbar"
        aria-label="사이트 도구"
      >
        <ThemeToggle client:load />

        <NavLink
          href="https://github.com/seongmin36"
          class="inline-flex size-8 items-center justify-center rounded-lg border-none bg-transparent text-gray-500 no-underline transition-colors duration-200 hover:bg-black/5 hover:text-gray-900 sm:size-9 dark:text-gray-400 dark:hover:bg-white/8 dark:hover:text-gray-50"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="GitHub"
        >
          <AppIcon name="github" className="size-4.5 sm:size-4.5" />
        </NavLink>

        <NavLink
          href="https://www.linkedin.com/in/krongsungmin/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="hover:text-brand-linkedin! dark:hover:text-brand-linkedin! inline-flex size-8 items-center justify-center rounded-lg border-none bg-transparent text-gray-500 no-underline transition-colors duration-200 hover:bg-black/5 sm:size-9 dark:text-gray-400 dark:hover:bg-white/8"
        >
          <AppIcon name="linkedin" className="size-4.5 sm:size-6" />
        </NavLink>

        <NavLink
          href="/rss.xml"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="RSS 피드"
          title="RSS 피드"
          class="hover:text-brand-rss! dark:hover:text-brand-rss! inline-flex size-8 items-center justify-center rounded-lg border-none bg-transparent text-gray-500 no-underline transition-colors duration-200 hover:bg-black/5 sm:size-9 dark:text-gray-400 dark:hover:bg-white/8"
        >
          <AppIcon name="rss" className="size-4.5 sm:size-4.5" />
        </NavLink>
      </div>
    </nav>
  </div>
</header>
