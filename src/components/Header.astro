---
import NavLink from "@/components/sections/NavLink.astro";
import { AppIcon } from "@/components/ui/AppIcons";
import { ThemeToggle } from "@/components/ui/ThemeToggle";

const NAV_ITEMS = [
  { href: "/about", label: "개발자 소개" },
  { href: "/blogs", label: "전체 글" },
] as const;
---

<header
  class="sticky top-0 z-50 w-full h-[60px] bg-white/85 dark:bg-dark/85 backdrop-blur-md border-b border-black/6 dark:border-white/6 transition-colors duration-300"
  id="main-header"
>
  <div class="flex items-center justify-between h-full max-w-[1200px] mx-auto px-4 sm:px-6">
    <a href="/" class="group flex items-center shrink-0 no-underline" data-astro-prefetch>
      <span class="text-lg font-bold text-gray-900 dark:text-gray-50 tracking-tight transition-colors duration-200 group-hover:text-primary dark:group-hover:text-primary">
        Krong Dev.
      </span>
    </a>

    <nav class="flex items-center gap-4 sm:gap-8" aria-label="메인 네비게이션">
      <ul class="flex items-center gap-3 sm:gap-6 list-none m-0 p-0" role="list">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <NavLink href={item.href}>{item.label}</NavLink>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-0 sm:gap-1" role="toolbar" aria-label="사이트 도구">
        <ThemeToggle client:load />


        <NavLink
          href="https://github.com/seongmin36"
          class="inline-flex items-center justify-center size-8 sm:size-9 border-none rounded-lg bg-transparent text-gray-500 dark:text-gray-400 no-underline transition-colors duration-200 hover:text-gray-900 hover:bg-black/5 dark:hover:text-gray-50 dark:hover:bg-white/8"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="GitHub"
        >
          <AppIcon name="github" className="size-4.5 sm:size-4.5" />
        </NavLink>


        <NavLink
        href="https://www.linkedin.com/in/krongsungmin/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="inline-flex items-center justify-center size-8 sm:size-9 border-none rounded-lg bg-transparent text-gray-500 dark:text-gray-400 no-underline transition-colors duration-200 hover:text-gray-900 hover:bg-black/5 dark:hover:text-gray-50 dark:hover:bg-white/8"
      >
          <AppIcon name="linkedin" className="size-4.5 sm:size-6" />
        </NavLink>
      </div>
    </nav>
  </div>
</header>
