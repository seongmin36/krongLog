---
import ResumeEntryHead from "@/components/resume/ResumeEntryHead.astro";
import type { ResumeContribution, ResumeEntry } from "@/lib/resume";

interface Props {
  entry: ResumeEntry;
  contributions: ResumeContribution[];
}

const { entry, contributions } = Astro.props;
---

<div>
  <ResumeEntryHead entry={entry} />
  <dl
    class="mt-3 grid grid-cols-[54px_1fr] gap-x-3 gap-y-1.5 text-[13.5px] leading-[1.65]"
  >
    {
      contributions.map((item) => (
        <>
          <dt>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-resume-accent no-underline hover:underline"
            >
              {item.number}
            </a>
          </dt>
          <dd class="break-keep">{item.text}</dd>
        </>
      ))
    }
  </dl>
</div>
