---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Krong's Dev Log",
  description = "Three.js와 웹 기술을 기록합니다.",
  image = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
  </head>

  <body
    class="bg-slate-950 text-slate-50 antialiased selection:bg-indigo-500/30"
  >
    <nav
      class="sticky top-0 z-40 border-b border-white/5 bg-slate-950/80 backdrop-blur-md"
    >
      <div
        class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4"
      >
        <a
          href="/"
          class="text-xl font-bold tracking-tighter transition-colors hover:text-indigo-400"
        >
          KRONG.LOG
        </a>
        <div class="flex gap-6 text-sm font-medium text-slate-400">
          <a href="/blog" class="transition-colors hover:text-white">Blog</a>
          <a href="/projects" class="transition-colors hover:text-white"
            >Projects</a
          >
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer
      class="border-t border-white/5 py-12 text-center text-sm text-slate-500"
    >
      <p>&copy; {new Date().getFullYear()} Krong. All rights reserved.</p>
    </footer>
  </body>
</html>
