---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Tag from "@/components/ui/Tag.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("post");

  return allPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags, image } = post.data;

const formattedDate = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
const ogImage = image ? new URL(image.src, Astro.site).href : undefined;
---

<BaseLayout
  title={`${title} | Krong Dev.`}
  description={description}
  ogImage={ogImage}
>
  <article class="mx-auto max-w-[720px] pt-12 pb-20 sm:pt-16">
    <!-- 글 헤더 -->
    <header
      class="mb-8 border-b border-gray-300 pb-8 sm:mb-10 dark:border-gray-600"
    >
      {
        tags && tags.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-1.5">
            {tags.map((tag: string) => (
              <Tag name={tag} size="sm" />
            ))}
          </div>
        )
      }

      <h1
        class="text-4xl leading-tight font-bold tracking-tight text-gray-900 sm:text-5xl dark:text-gray-50"
      >
        {title}
      </h1>

      {
        description && (
          <p class="text-description dark:text-dark-description mt-3 text-base leading-relaxed">
            {description}
          </p>
        )
      }

      <time
        datetime={date.toISOString()}
        class="mt-4 block text-sm text-gray-400 dark:text-gray-500"
      >
        {formattedDate}
      </time>
    </header>

    <!-- 히어로 이미지 -->
    {
      image && (
        <div class="mb-8 overflow-hidden rounded-lg sm:mb-10">
          <Image
            src={image}
            alt={title}
            width={720}
            height={400}
            format="webp"
            quality={85}
            class="h-auto w-full rounded-lg object-cover"
          />
        </div>
      )
    }

    <!-- MDX 본문 -->
    <div class="prose prose-blog">
      <Content />
    </div>

    <!-- 하단 네비게이션 -->
    <div class="mt-16 border-t border-gray-100 pt-6 dark:border-gray-800">
      <a
        href="/blogs"
        class="hover:text-primary inline-flex items-center gap-1.5 text-sm text-gray-500 transition-colors duration-200 dark:text-gray-400"
        data-astro-prefetch
      >
        <span>←</span>
        <span>목록으로 돌아가기</span>
      </a>
    </div>
  </article>
</BaseLayout>
