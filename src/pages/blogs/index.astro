---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostsPage from "@/components/blog/PostsPage.astro";
import { countTopTags, getSortedPosts } from "@/lib/blog";

const sortedPosts = await getSortedPosts();
const topTags = countTopTags(sortedPosts);

const subTagsByLabel: Record<string, [string, number][]> = {};
for (const [label] of topTags) {
  const counts = new Map<string, number>();
  for (const post of sortedPosts) {
    const tags = post.data.tags ?? [];
    if (!tags.includes(label)) continue;
    for (const tag of tags) {
      if (tag === label) continue;
      counts.set(tag, (counts.get(tag) ?? 0) + 1);
    }
  }
  subTagsByLabel[label] = [...counts.entries()].sort((a, b) => b[1] - a[1]);
}
---

<BaseLayout
  title="전체 글 | KrongLog"
  description="개발하면서 배운 것들을 기록합니다."
  ogType="website"
>
  <PostsPage
    posts={sortedPosts}
    topTags={topTags}
    subTagsByLabel={subTagsByLabel}
  />
</BaseLayout>
