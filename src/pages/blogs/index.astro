---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/blog/PostCard.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("post");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="전체 글 | Krong Dev."
  description="개발하면서 배운 것들을 기록합니다."
  ogType="article"
>
  <section class="pt-12 pb-8 sm:pt-16 sm:pb-10">
    <h1
      class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl dark:text-gray-50"
    >
      전체 글
    </h1>
    <p class="mt-2 text-sm text-gray-500 sm:text-base dark:text-gray-400">
      제가 차곡차곡 모아둔 이야기들을 만나보세요.
    </p>
  </section>

  <section class="pb-16 sm:pb-20">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {sortedPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
