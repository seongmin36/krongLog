---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutActivities from "@/components/about/AboutActivities.astro";
import AboutEvents from "@/components/about/AboutEvents.astro";
import AboutHero from "@/components/about/AboutHero.astro";
import AboutNow from "@/components/about/AboutNow.astro";
import AboutOutro from "@/components/about/AboutOutro.astro";
import AboutRecords from "@/components/about/AboutRecords.astro";
import AboutResume from "@/components/about/AboutResume.astro";
import AboutValues from "@/components/about/AboutValues.astro";
import { getSortedArchive } from "@/lib/archive";
import { countTopTags, getSortedPosts } from "@/lib/blog";

const posts = await getSortedPosts();
const archive = await getSortedArchive();
const topTags = countTopTags(posts, 5);
---

<BaseLayout
  title="개발자 소개 | Krong Dev."
  description="사람들과 이야기하는 걸 좋아하는 프론트엔드 개발자 조성민입니다."
  ogType="website"
>
  <AboutHero />
  <AboutValues />
  <AboutNow />
  <AboutActivities />
  <AboutEvents />
  <AboutRecords
    postCount={posts.length}
    archiveCount={archive.length}
    topTags={topTags}
  />
  <AboutResume />
  <AboutOutro />
</BaseLayout>
