---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/blog/PostCard.astro";
import { getCollection } from "astro:content";

// 모든 포스트를 가져와서 날짜 기준 내림차순 정렬
const allPosts = await getCollection("post");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="Krong Dev."
  description="개발하면서 배운 것들을 기록합니다."
  ogType="website"
>
  <!-- 히어로 섹션 -->
  <section class="pt-12 pb-8 sm:pt-16 sm:pb-10">
    <h1
      class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl dark:text-gray-50"
    >
      최근 글
    </h1>
    <p class="mt-2 text-sm text-gray-500 sm:text-base dark:text-gray-400">
      개발하면서 배운 것들을 기록합니다.
    </p>
  </section>

  <!-- 포스트 카드 섹션 -->
  <section class="pb-16 sm:pb-20">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {sortedPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
