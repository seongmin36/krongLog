---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeHero from "@/components/blog/HomeHero.astro";
import HomePosts from "@/components/blog/HomePosts.astro";
import { getCollection } from "astro:content";
import { countTopTags } from "@/lib/post-tags";

// 모든 포스트를 가져와서 날짜 기준 내림차순 정렬
const allPosts = await getCollection("post");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const topTags = countTopTags(sortedPosts);

// 최근 업데이트: 수정일(updatedDate)까지 포함한 가장 최신 날짜
const lastUpdated = new Date(
  Math.max(
    0,
    ...sortedPosts.map((post) =>
      (post.data.updatedDate ?? post.data.date).getTime(),
    ),
  ),
);
---

<BaseLayout
  title="Krong Dev."
  description="개발하면서 배운 것들을 기록합니다."
  ogType="website"
>
  <HomeHero postCount={sortedPosts.length} lastUpdated={lastUpdated} />
  <HomePosts posts={sortedPosts} topTags={topTags} />
</BaseLayout>
