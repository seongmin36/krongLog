---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeHero from "@/components/blog/HomeHero.astro";
import HomePosts from "@/components/blog/HomePosts.astro";
import { getCollection } from "astro:content";

// 모든 포스트를 가져와서 날짜 기준 내림차순 정렬
const allPosts = await getCollection("post");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="Krong Dev."
  description="개발하면서 배운 것들을 기록합니다."
  ogType="website"
>
  <HomeHero
    postCount={sortedPosts.length}
    lastUpdated={sortedPosts[0].data.date}
  />
  <HomePosts posts={sortedPosts} />
</BaseLayout>
