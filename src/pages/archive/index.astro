---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArchiveHero from "@/components/archive/ArchiveHero.astro";
import ArchiveList from "@/components/archive/ArchiveList.astro";
import {
  buildArchiveFilters,
  chunkEntries,
  getSortedArchive,
} from "@/lib/archive";

const entries = await getSortedArchive();
const filters = buildArchiveFilters(entries);
const [firstChunk = []] = chunkEntries(entries);
---

<BaseLayout
  title="아카이브 | Krong Dev."
  description="블로그 글이 되기엔 가벼운 짧은 생각과 기록을 모아 둡니다."
  ogType="website"
>
  <ArchiveHero total={entries.length} />
  <ArchiveList entries={firstChunk} filters={filters} />
</BaseLayout>
