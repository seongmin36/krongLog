---
// 아카이브 목록 "더 보기"용 HTML 조각 (레이아웃 없이 카드만 렌더링)
export const partial = true;

import ArchiveCard from "@/components/archive/ArchiveCard.astro";
import {
  buildArchiveFilters,
  chunkEntries,
  filterByTag,
  getSortedArchive,
  type ArchiveEntry,
} from "@/lib/archive";

export async function getStaticPaths() {
  const entries = await getSortedArchive();

  return buildArchiveFilters(entries).flatMap(({ key, tag }) =>
    chunkEntries(filterByTag(entries, tag)).map((chunk, index) => ({
      params: { key, page: String(index + 1) },
      props: { entries: chunk },
    })),
  );
}

interface Props {
  entries: ArchiveEntry[];
}

const { entries } = Astro.props;
---

{entries.map((entry) => <ArchiveCard entry={entry} />)}
